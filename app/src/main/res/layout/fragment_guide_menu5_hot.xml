<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:background="#FFF"
    tools:context=".GuideMenu5HotFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="뒤로가기"
            android:padding="8dp"
            android:layout_marginStart="-8dp"
            app:tint="#000000" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="발열 / 소음 / 멈춤 현상"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="컴퓨터가 너무 뜨겁거나 시끄러운 소리가 나나요? 부팅 후 얼마 안 가서 꺼진다면 발열 문제입니다."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="24dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️ 필수 확인"
                            android:textColor="#D32F2F"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/check_cooler_film"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU 쿨러 밑면 비닐 제거"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#D32F2F"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="쿨러 바닥의 투명 보호 스티커(Warning 스티커)를 떼지 않고 장착하면 온도가 100도까지 치솟아 PC가 꺼집니다."
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#333333"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="fitCenter"
                        android:layout_marginTop="12dp"
                        android:background="#E0E0E0"
                        tools:src="@tools:sample/backgrounds/scenic"
                        android:contentDescription="쿨러 보호 비닐 제거 예시"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/check_fan_direction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="케이스 쿨러 장착 방향"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="보통 '로고가 없는 쪽(살대가 있는 쪽)'으로 바람이 나갑니다.\n\n• 전면/하단: 흡기 (바람이 들어옴)\n• 후면/상단: 배기 (바람이 나감)"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="fitCenter"
                        android:layout_marginTop="8dp"
                        android:background="#E0E0E0"
                        tools:src="@tools:sample/backgrounds/scenic"
                        android:contentDescription="팬 흡기 배기 방향 예시"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/check_noise_cable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다다닥! 소음 (선 간섭)"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="'다다닥' 거리는 소음은 99% 선정리가 덜 된 케이블이 회전하는 팬 날개를 치고 있는 소리입니다. 팬 주변 선을 정리해주세요."
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 팁: CPU 쿨러 나사는 대각선 방향으로 번갈아가며 조금씩 조여야 장력이 고르게 분산됩니다."
                    android:background="@drawable/bg_item_rounded_gray"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#555555"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>