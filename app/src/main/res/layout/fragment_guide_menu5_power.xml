<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:background="#FFF"
    tools:context=".GuideMenu5PowerFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="뒤로가기"
            android:padding="8dp"
            android:layout_marginStart="-8dp"
            app:tint="#000000" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="전원이 켜지지 않아요"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="팬도 돌지 않고 LED도 들어오지 않는다면 다음 항목들을 순서대로 체크해보세요."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="24dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/check_psu_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="파워서플라이 스위치 확인"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PC 뒷면 파워서플라이의 스위치가 'O'가 아닌 'I' (일자 모양) 쪽으로 눌려 있는지 확인하세요."
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:scaleType="fitCenter"
                        android:layout_marginTop="10dp"
                        android:background="#E0E0E0"
                        tools:src="@tools:sample/backgrounds/scenic"
                        android:contentDescription="파워 스위치 예시 이미지"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/check_front_panel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전면 패널 커넥터 (JFP1)"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="케이스 전원 버튼 선(POWER SW)이 메인보드의 올바른 핀에 꽂혔는지 확인하세요. 가장 흔한 실수 원인입니다."
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="fitCenter"
                        android:layout_marginTop="10dp"
                        android:background="#E0E0E0"
                        tools:src="@tools:sample/backgrounds/scenic"
                        android:contentDescription="전면 패널 커넥터 연결 예시"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/check_cables"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="메인보드 &amp; CPU 전원 케이블"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. 메인보드 우측 24핀 주전원\n2. 좌측 상단 CPU 보조전원(4핀 또는 8핀)\n\n이 두 가지가 꽉 끼워졌는지 확인하세요."
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 팁: 멀티탭 전원이 켜져 있는지도 꼭 확인해보세요!"
                    android:background="#FFF9C4"
                    android:padding="12dp"
                    android:textStyle="bold"
                    android:gravity="center"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>