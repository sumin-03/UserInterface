<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="CPU 장착 방법"
    android:textSize="24sp"
    android:textStyle="bold"
    android:textColor="#000000"
    android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFEBEE"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="#D32F2F"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주의: 메인보드 소켓 핀은 매우 약합니다.\n절대 손으로 만지거나 힘을 주지 마세요!"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 1. 소켓 걸쇠 열기"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/img_cpu_step1"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#E0E0E0"
                android:scaleType="centerCrop"
                android:src="@drawable/view_guide_cpu1"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="메인보드 소켓 옆에 있는 철제 걸쇠(레버)를 살짝 눌러 옆으로 빼낸 뒤, 위로 끝까지 들어 올리세요."
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#555555"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 2. 방향 맞추기"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/img_cpu_step2"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#E0E0E0"
                android:scaleType="centerCrop"
                android:src="@drawable/view_guide_cpu2"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CPU의 모서리와 메인보드 소켓 모서리를 보면 '화살표(▲)' 혹은 '금색 삼각형' 표시가 있습니다.\n\n이 두 표시의 위치가 일치하도록 방향을 잡아주세요."
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#555555"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 3. 장착 및 고정"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/img_cpu_step3"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#E0E0E0"
                android:scaleType="centerCrop"
                android:src="@drawable/view_guide_cpu3"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. CPU를 소켓 위에 '살포시' 얹어놓습니다. (누르지 마세요!)\n2. 흔들리지 않고 쏙 들어갔다면, 걸쇠를 다시 내려 원래대로 고정합니다.\n\n*걸쇠를 닫을 때는 다소 뻑뻑할 수 있으나 정상이니 힘을 주어 닫으세요."
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#555555"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>