<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <ImageButton
                android:id="@+id/menu1_cpu_btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="뒤로가기"
                android:padding="8dp"
                android:layout_marginStart="-8dp"
                app:tint="#000000" />

            <ImageView
                android:id="@+id/iv_guide_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:contentDescription="부품 아이콘"
                android:src="@drawable/iv_cpu"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/tv_guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="30dp"
                android:text="CPU (중앙처리장치)"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_gray_box"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="💡 핵심 역할"
                    android:textColor="#3F51B5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_role_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="컴퓨터의 '두뇌'에 해당합니다. 모든 프로그램의 실행 명령을 처리하고 연산을 담당합니다. 성능이 좋을수록 게임 프레임 방어가 잘 되고 작업 속도가 빨라집니다."
                    android:textColor="#424242"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_gray_box"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="✅ 선택 시 중점 포인트"
                    android:textColor="#009688"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_point_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. 코어와 스레드 수"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_1_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="다중 작업을 많이 한다면 코어 수가 많은 것이 유리합니다. 게임용이라면 6~8코어 정도면 충분합니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

                <TextView
                    android:id="@+id/tv_point_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. 클럭 속도 (GHz)"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_2_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="숫자가 높을수록 처리 속도가 빠릅니다. 단일 작업 성능에 큰 영향을 미칩니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

                <TextView
                    android:id="@+id/tv_point_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. 소켓 호환성"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_3_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="메인보드와 소켓 규격(예: LGA1700, AM5)이 일치해야 장착할 수 있습니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>