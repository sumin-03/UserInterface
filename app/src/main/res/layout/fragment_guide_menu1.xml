<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GuideMenuFragment"
    android:background="#FFFFFF"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/menu1_btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="뒤로가기"
            android:padding="8dp"
            android:layout_marginStart="-8dp"
            app:tint="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="부품 별 역할"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/menu_item_cpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CPU"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_item_rounded_gray"
            android:padding="20dp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="#000000"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/menu_item_vga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="그래픽카드"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_item_rounded_gray"
            android:padding="20dp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="#000000"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/menu_item_ram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RAM"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_item_rounded_gray"
            android:padding="20dp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="#000000"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/menu_item_mb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="메인보드"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_item_rounded_gray"
            android:padding="20dp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="#000000"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/menu_item_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="파워"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_item_rounded_gray"
            android:padding="20dp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="#000000"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/menu_item_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="저장장치"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_item_rounded_gray"
            android:padding="20dp"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:drawableTint="#000000"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</FrameLayout>