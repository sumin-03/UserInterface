<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:background="#FFF"
    tools:context=".GuideMenu5DisplayFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="뒤로가기"
            android:padding="8dp"
            android:layout_marginStart="-8dp"
            app:tint="#000000" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="화면이 나오지 않아요"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="본체 팬은 돌아가는데 모니터에 '신호 없음'이 뜬다면 아래 항목들을 확인해주세요."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="24dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 가장 많이 하는 실수!"
                        android:textColor="#EF6C00"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/check_cable_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="모니터 케이블 위치 확인"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#000000"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="외장 그래픽카드가 있다면, 케이블을 메인보드(위쪽)가 아닌 그래픽카드(아래쪽 가로 슬롯)에 꽂아야 합니다."
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="4dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="fitCenter"
                        android:layout_marginTop="12dp"
                        android:background="#E0E0E0"
                        tools:src="@tools:sample/backgrounds/scenic"
                        android:contentDescription="그래픽카드 포트 위치 설명 이미지"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/check_ram_seat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="램(RAM) 재장착"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="화면 불량의 90%는 램 접촉 불량입니다.\n램을 뺐다가 '딸깍' 소리가 날 때까지 힘줘서 다시 꽂아주세요."
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/check_gpu_power"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="그래픽카드 보조전원 연결"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="그래픽카드 옆면의 6핀/8핀 전원 케이블이 빠짐없이 연결되었나요?"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:scaleType="fitCenter"
                        android:layout_marginTop="8dp"
                        android:background="#E0E0E0"
                        tools:src="@tools:sample/backgrounds/scenic"
                        android:contentDescription="그래픽카드 보조전원 예시"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_item_rounded_gray"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/check_monitor_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="모니터 입력 소스 확인"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="모니터 자체 메뉴 버튼을 눌러 입력 신호가 현재 연결된 케이블(HDMI/DP)로 선택되어 있는지 확인하세요."
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>