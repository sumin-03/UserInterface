<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageButton
                android:id="@+id/menu1_psu_btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="뒤로가기"
                android:padding="8dp"
                android:layout_marginStart="-8dp"
                app:tint="#000000" />

            <ImageView
                android:id="@+id/iv_guide_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:contentDescription="부품 아이콘"
                android:src="@drawable/iv_power"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/tv_guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="30dp"
                android:text="파워서플라이 (PSU)"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_gray_box"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="💡 핵심 역할"
                    android:textColor="#3F51B5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_role_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="컴퓨터의 '심장'입니다. 가정용 전기를 컴퓨터가 사용할 수 있는 직류 전기로 변환하여 각 부품에 공급합니다. 파워가 좋지 않으면 전력 공급이 불안정해져 컴퓨터가 갑자기 꺼지거나 부품이 고장날 수 있습니다."
                    android:textColor="#424242"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_gray_box"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="✅ 선택 시 중점 포인트"
                    android:textColor="#009688"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_point_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. 정격 출력 (W)"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_1_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="CPU와 그래픽카드가 사용하는 전력량보다 여유 있게 선택해야 합니다. 보통 게이밍 PC는 600~700W, 고사양은 850W 이상을 권장합니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

                <TextView
                    android:id="@+id/tv_point_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. 80Plus 효율 등급"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_2_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="전기 효율에 대한 인증입니다. Standard &lt; Bronze &lt; Silver &lt; Gold 등급 순으로 좋으며, 등급이 높을수록 전기세 낭비가 적고 발열이 적습니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

                <TextView
                    android:id="@+id/tv_point_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. 모듈러 유무"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_3_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="필요한 선만 꽂아서 쓰는 방식을 '풀 모듈러'라고 합니다. 선정리가 훨씬 간편하고 내부 공기 흐름에도 유리합니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>