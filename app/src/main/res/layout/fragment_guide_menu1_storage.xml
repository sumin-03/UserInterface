<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageButton
                android:id="@+id/menu1_storage_btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="뒤로가기"
                android:padding="8dp"
                android:layout_marginStart="-8dp"
                app:tint="#000000" />

            <ImageView
                android:id="@+id/iv_guide_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:contentDescription="부품 아이콘"
                android:src="@drawable/iv_storage"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/tv_guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="30dp"
                android:text="저장공간 (SSD / HDD)"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_gray_box"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="💡 핵심 역할"
                    android:textColor="#3F51B5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_role_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="컴퓨터의 '책장'입니다. 윈도우, 게임, 사진, 문서 등 모든 데이터를 영구적으로 보관합니다. 저장 장치의 속도가 빠르면 부팅 속도와 게임 로딩 시간이 획기적으로 단축됩니다."
                    android:textColor="#424242"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_gray_box"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="✅ 선택 시 중점 포인트"
                    android:textColor="#009688"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_point_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. 종류 (SSD vs HDD)"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_1_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="메인 드라이브는 무조건 빠른 SSD를 써야 합니다. HDD는 속도가 느리지만 저렴하므로 단순 사진/영상 백업용으로만 추천합니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

                <TextView
                    android:id="@+id/tv_point_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. 인터페이스 (M.2 NVMe)"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_2_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="최근에는 선 없이 메인보드에 바로 꽂는 'M.2 NVMe' 방식이 표준입니다. 기존 SATA 방식보다 월등히 빠르고 공간도 적게 차지합니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

                <TextView
                    android:id="@+id/tv_point_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. 용량 (Capacity)"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_point_3_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="최신 게임 용량이 100GB를 넘는 경우가 많습니다. 500GB는 금방 부족해질 수 있으므로, 예산이 허락한다면 1TB 이상을 강력 추천합니다."
                    android:textSize="14sp"
                    android:textColor="#616161"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>