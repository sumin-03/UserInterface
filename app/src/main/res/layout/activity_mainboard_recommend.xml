<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    tools:context=".MainboardRecommend">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingBottom="16dp"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="@android:color/transparent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="사용하는 다른 부품을 선택하여 주십시오"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/select_cpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@android:color/white"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:shape="rectangle"

                android:layout_margin="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CPU 선택하기"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/selected_cpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@android:color/white"
                android:layout_margin="4dp"
                android:elevation="0dp">

                <TextView
                    android:id="@+id/selected_cpu_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="선택된 CPU"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#3F51B5" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/select_ram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@android:color/white"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:shape="rectangle"
                android:layout_margin="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RAM 버전 및 용량 선택하기"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/selected_ram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@android:color/white"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/selected_ram_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="선택된 RAM"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end">

                    <ImageView
                        android:id="@+id/sub"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/outline_sub" />

                    <TextView
                        android:id="@+id/count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="0"
                        android:textColor="#111111"
                        android:textSize="20sp" />

                    <ImageView
                        android:id="@+id/add"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/outline_add" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#3F51B5" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/select_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@android:color/white"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:shape="rectangle"

                android:layout_margin="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="크기 선택하기"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/selected_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@android:color/white"
                android:layout_margin="4dp"
                android:elevation="0dp">

                <TextView
                    android:id="@+id/selected_size_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="선택된 크기"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#3F51B5" />
            </LinearLayout>
            <Button
                android:id="@+id/btn_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="메인보드 추천받기"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="#3F51B5"
                android:padding="14dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp"
                android:layout_marginHorizontal="4dp" />
        </LinearLayout>

    </ScrollView>

</RelativeLayout>
