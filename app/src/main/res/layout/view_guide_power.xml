<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="파워 서플라이 장착 방법"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFF3E0"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_help"
                app:tint="#EF6C00"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tip: 선이 분리되는 '모듈러' 파워인가요?\n그렇다면 케이스에 넣기 전에 필요한 선을 미리 파워에 꽂으세요! (넣고 나면 손이 안 들어갑니다.)"
                android:textColor="#EF6C00"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 1. 팬 방향 확인 (중요)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/img_power_step1"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#E0E0E0"
                android:scaleType="centerCrop"
                android:src="@drawable/view_guide_power2"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="대부분의 케이스는 바닥에 통풍구가 있습니다.\n파워 서플라이의 큰 팬이 '바닥을 향하도록' 뒤집어서 넣어주세요.\n\n*팬이 위를 향하면 그래픽카드의 열기를 그대로 흡입하게 됩니다."
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#555555"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 2. 나사로 고정하기"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/img_power_step2"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#E0E0E0"
                android:scaleType="centerCrop"
                android:src="@drawable/view_guide_power3"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 파워를 케이스 하단 공간에 밀어 넣습니다.\n2. 케이스 뒷면에서 동봉된 '육각 나사' 4개를 사용하여 단단히 고정합니다."
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#555555"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="※ 24핀, CPU 보조전원 등 상세 연결 방법은\n'메인보드 조립' 탭에서 다룹니다."
        android:textSize="13sp"
        android:textColor="#757575"
        android:gravity="center"
        android:padding="8dp"/>

</LinearLayout>